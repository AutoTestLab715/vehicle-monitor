# ========== Flask 服务端口 ==========
PORT=3000

# ========== MySQL（改成你本机实际的账号密码）==========
# 格式: mysql+pymysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
# 密码含特殊字符需 URL 编码，如 @ 写成 %40
#
# 示例1 - root 用户（最常见）:
# DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/vehicle_monitor?charset=utf8mb4
#
# 示例2 - 独立账号:
# DATABASE_URL=mysql+pymysql://vehicle:vehicle123@127.0.0.1:3306/vehicle_monitor?charset=utf8mb4
#
DATABASE_URL=mysql+pymysql://root:你的密码@127.0.0.1:3306/vehicle_monitor?charset=utf8mb4

# ========== MQTT Broker（改成你本机 MQTT 的地址）==========
# Mosquitto / EMQX 本机默认一般是 127.0.0.1:1883
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883

# 若 Broker 开启了用户名密码认证，填写下面两项；匿名则留空
MQTT_USERNAME=
MQTT_PASSWORD=

MQTT_TELEMETRY_TOPIC=vehicle/+/telemetry
MQTT_COMMAND_PREFIX=vehicle
